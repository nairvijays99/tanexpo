{
  "name": "vite-plugin-tanexpo",
  "version": "0.2.0",
  "description": "Vite plugin for TanExpo web app",
  "author": "Vijay S Nair",
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/vite-plugin",
    "url": "https://github.com/nairvijays99/tanexpo"
  },
  "keywords": [
    "vite-plugin",
    "vite-plugin-tanexpo",
    "tanexpo"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome lint .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
